# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────

# Server-side URL (used in server functions, never exposed to browser)
SUPABASE_URL=https://<project>.supabase.co

# Anon key — safe to expose to browser; RLS restricts all access
SUPABASE_ANON_KEY=eyJ...

# Service-role key — SERVER ONLY. NEVER ship to browser or commit.
# Used only in the Clerk webhook handler to look up users by email.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret — used ONLY to configure the Clerk JWT template.
# NOT consumed at runtime; the app uses Clerk's getToken() instead.
SUPABASE_JWT_SECRET=...

# For pnpm supabase:types script
SUPABASE_PROJECT_ID=<dev-project-id>

# VITE_ prefix = exposed to browser bundle
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────────────────
# Clerk Auth
# ─────────────────────────────────────────────────────────────────────────────

# Publishable key — safe to expose to browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key — SERVER ONLY
CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret (from Clerk dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# Vercel AI Gateway
# ─────────────────────────────────────────────────────────────────────────────

# API key from Vercel dashboard → AI → AI Gateway
AI_GATEWAY_API_KEY=...

# Model identifiers — override to switch models without code change
# Primary: openai/gpt-4o is a safe fallback if gpt-5 isn't available yet
JADE_MODEL=openai/gpt-4o
JADE_FALLBACK_MODEL=anthropic/claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Override Vite default port (3000)
PORT=3000

# Set to a|b|c|d|e to mark a variant as "currently testing" on the landing page.
VITE_FOCUS_VARIANT=
